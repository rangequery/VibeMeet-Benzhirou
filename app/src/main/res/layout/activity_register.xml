<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:background="@drawable/header_gradient">

            <ImageView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:src="@drawable/ic_splash_logo"
                android:contentDescription="VibeMeet logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create your space"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_on_primary"
                android:layout_marginTop="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal recommendations, saved places and avatar tools."
                android:textSize="16sp"
                android:textColor="#DCE7FF"
                android:gravity="center"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-40dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Join VibeMeet"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="22dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="@color/brand_primary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/pseudoEditText"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:hint="Your name"
                    android:inputType="textPersonName"
                    android:autofillHints="username"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/input_background"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:singleLine="true"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email address"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="@color/brand_primary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/emailEditText"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:hint="you@example.com"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/input_background"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:singleLine="true"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="@color/brand_primary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/passwordEditText"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:hint="Minimum 6 characters"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/input_background"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:layout_marginBottom="22dp" />

                <Button
                    android:id="@+id/registerButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Create account"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/primary_button_bg"
                    android:backgroundTint="@null"
                    android:textColor="@color/text_on_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account?  "
                android:textSize="15sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/loginLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
