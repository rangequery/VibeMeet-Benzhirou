<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/sheetVenuePhoto"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:background="@color/surface_variant"
        android:contentDescription="Venue photo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/sheetVenueName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Venue Name"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/sheetVenueType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Restaurant · 4.5 rating"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/sheetVenueDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1.2 km away"
            android:textSize="14sp"
            android:textColor="@color/brand_primary"
            android:background="@drawable/brand_count_pill_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/sheetViewDetails"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="Details"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/primary_button_bg"
                android:backgroundTint="@null"
                android:textColor="@color/text_on_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/sheetNavigate"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="Navigate"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/secondary_button_bg"
                android:backgroundTint="@null"
                android:textColor="@color/brand_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
