<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HERO IMAGE SECTION -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <ImageView
                android:id="@+id/venuePhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/surface_variant"
                android:contentDescription="Venue photo" />

            <!-- Gradient overlay at bottom -->
            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="bottom"
                android:background="@drawable/hero_overlay" />

            <!-- Category Badge (Bottom Left) -->
            <TextView
                android:id="@+id/venueTypeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="16dp"
                android:text="Restaurant"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_on_primary"
                android:background="@drawable/venue_badge_bg"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:elevation="4dp" />

            <!-- Favorite Button (Top Right) -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/favorite_button_bg">

                <ImageButton
                    android:id="@+id/favoriteBtn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_heart_outline_dark"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Save" />

            </FrameLayout>

            <!-- Open/Closed Badge (Top Left) -->
            <LinearLayout
                android:id="@+id/openBadgeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/badge_pill_bg"
                android:visibility="gone"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open now"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

        </FrameLayout>

        <!-- CONTENT SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Title + Price Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/venueName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Venue Name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01" />

                <TextView
                    android:id="@+id/venuePrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$$"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_accent"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

            <!-- Rating + Reviews + Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <RatingBar
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:isIndicator="true"
                        android:rating="4.5"
                        android:scaleX="0.7"
                        android:scaleY="0.7"
                        android:layout_marginStart="-6dp"
                        android:layout_marginEnd="2dp" />

                    <TextView
                        android:id="@+id/venueRatingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.5"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(120)"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textSize="16sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginHorizontal="8dp" />

                <TextView
                    android:id="@+id/venueDistrict"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="District"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <!-- Distance + Directions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="11dp"
                android:background="@drawable/info_strip_bg">

                <TextView
                    android:id="@+id/venueWalkTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="12 min walk • 0.8 km"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <Button
                    android:id="@+id/directionsBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Get Directions"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_primary"
                    android:backgroundTint="@color/brand_primary"
                    android:paddingHorizontal="18dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
